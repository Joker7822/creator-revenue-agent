APP_ENV=development
CUSTOM_API_BASE_URL=http://127.0.0.1:8000
CUSTOM_API_TOKEN=replace-me
INTERNAL_API_TOKEN=replace-me

DATABASE_URL=sqlite:///./agent.db

MIN_CREATOR_AGE=18
REQUIRE_HUMAN_REVIEW=true
ALLOW_AUTO_PUBLISH=false

# Experiment statistical readiness gates
EXPERIMENT_MIN_RUNTIME_HOURS=24
EXPERIMENT_MIN_ASSIGNMENTS_PER_ARM=100
EXPERIMENT_MIN_IMPRESSIONS_PER_ARM=100
EXPERIMENT_MIN_CLICKS_PER_ARM=20

# Service identities and RBAC.
# Store this value as a secret in production; never commit real tokens.
SERVICE_IDENTITIES_JSON={"content-reviewer":{"token":"replace-reviewer-token","roles":["reviewer"]},"publisher":{"token":"replace-publisher-token","roles":["publisher"]},"experiment-operator":{"token":"replace-experiment-token","roles":["experiment_operator"]},"rollout-planner":{"token":"replace-planner-token","roles":["planner"]},"release-manager":{"token":"replace-release-token","roles":["release_manager"]},"rollout-operator":{"token":"replace-rollout-token","roles":["rollout_operator"]},"incident-manager":{"token":"replace-incident-token","roles":["incident_manager"]}}
ALLOW_LEGACY_ADMIN_TOKEN=false
