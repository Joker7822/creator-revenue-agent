APP_ENV=development
CUSTOM_API_BASE_URL=http://127.0.0.1:8000
CUSTOM_API_TOKEN=replace-me
INTERNAL_API_TOKEN=replace-me

DATABASE_URL=sqlite:///./agent.db
# Production should use PostgreSQL or another row-locking database.
PRODUCTION_REQUIRE_ROW_LOCKING_DATABASE=true

MIN_CREATOR_AGE=18
REQUIRE_HUMAN_REVIEW=true
ALLOW_AUTO_PUBLISH=false

# Experiment statistical readiness gates
EXPERIMENT_MIN_RUNTIME_HOURS=24
EXPERIMENT_MIN_ASSIGNMENTS_PER_ARM=100
EXPERIMENT_MIN_IMPRESSIONS_PER_ARM=100
EXPERIMENT_MIN_CLICKS_PER_ARM=20

# Service identities and RBAC.
# Store this value as a secret in production; never commit real tokens.
SERVICE_IDENTITIES_JSON={"verification-writer":{"token":"replace-verification-token","roles":["verification_writer"]},"billing-writer":{"token":"replace-billing-token","roles":["billing_writer"]},"audit-anchor-operator":{"token":"replace-audit-anchor-token","roles":["audit_anchor_operator"]},"content-reviewer":{"token":"replace-reviewer-token","roles":["reviewer"]},"publisher":{"token":"replace-publisher-token","roles":["publisher"]},"experiment-operator":{"token":"replace-experiment-token","roles":["experiment_operator"]},"rollout-planner":{"token":"replace-planner-token","roles":["planner"]},"release-manager":{"token":"replace-release-token","roles":["release_manager"]},"rollout-operator":{"token":"replace-rollout-token","roles":["rollout_operator"]},"incident-manager":{"token":"replace-incident-token","roles":["incident_manager"]}}
ALLOW_LEGACY_ADMIN_TOKEN=false

# Short-lived signed service credentials.
# JWT-only is the production target. Use hybrid only during migration/bootstrap.
SERVICE_AUTH_MODE=jwt
SERVICE_JWT_KEYS_JSON={"2026-10-primary":"replace-with-32-plus-byte-secret","2026-09-retiring":"replace-with-32-plus-byte-retiring-secret"}
SERVICE_JWT_ACTIVE_KID=2026-10-primary
SERVICE_JWT_ISSUER=creator-revenue-agent
SERVICE_JWT_AUDIENCE=creator-revenue-agent-internal
SERVICE_JWT_MAX_TTL_SECONDS=900
SERVICE_JWT_REQUIRE_ISSUED_RECORD=true

# Require server-managed age and consent verification records.
REQUIRE_TRUSTED_VERIFICATION=true

# Verification Provider webhook authentication.
# Keep real provider secrets in deployment secret storage.
VERIFICATION_WEBHOOK_KEYS_JSON={"provider-a":{"2026-09-retiring":"replace-with-32-plus-byte-old-provider-secret","2026-10-current":"replace-with-32-plus-byte-new-provider-secret"}}
VERIFICATION_WEBHOOK_REQUIRE_KEY_ID=true
VERIFICATION_WEBHOOK_MAX_AGE_SECONDS=300
VERIFICATION_WEBHOOK_MAX_BODY_BYTES=65536

# Tamper-evident audit HMAC keys.
# Historical verification keys must remain available for chain verification.
AUDIT_HASH_KEYS_JSON={"2026-10-current":"replace-with-32-plus-byte-audit-hmac-secret"}
AUDIT_HASH_ACTIVE_KID=2026-10-current

# External append-only / WORM audit anchor service.
# Historical receipt verification keys must remain available.
AUDIT_ANCHOR_BASE_URL=https://audit-anchor.example.internal
AUDIT_ANCHOR_TOKEN=replace-with-anchor-service-token
AUDIT_ANCHOR_NAMESPACE=creator-revenue-agent-production
AUDIT_ANCHOR_RECEIPT_KEYS_JSON={"2026-10-current":"replace-with-32-plus-byte-anchor-receipt-secret"}
AUDIT_ANCHOR_TIMEOUT_SECONDS=5

# Anchor freshness gates.
AUDIT_ANCHOR_MAX_AGE_SECONDS=900
AUDIT_ANCHOR_MAX_UNANCHORED_EVENTS=100
ENFORCE_AUDIT_ANCHOR_FRESHNESS_ON_ROLLOUT=true

# Process-local operational alert thresholds.
OPS_ALERT_5XX_THRESHOLD=1
OPS_ALERT_ROLLOUT_FAILURE_THRESHOLD=1
OPS_ALERT_ROLLOUT_DRIFT_THRESHOLD=1
OPS_ALERT_ROLLBACK_FAILURE_THRESHOLD=1
OPS_ALERT_AUDIT_ANCHOR_FAILURE_THRESHOLD=1
OPS_ALERT_WEBHOOK_REJECTION_THRESHOLD=5
OPS_ALERT_AUTH_REJECTION_THRESHOLD=20
OPS_ALERT_READINESS_FAILURE_THRESHOLD=1


# Secret-file alternative for production.
# For any supported secret, set either NAME or NAME_FILE, never both.
# Example:
# DATABASE_URL_FILE=/run/secrets/database_url
# SERVICE_JWT_KEYS_JSON_FILE=/run/secrets/service_jwt_keys_json
# VERIFICATION_WEBHOOK_KEYS_JSON_FILE=/run/secrets/verification_webhook_keys_json
# AUDIT_HASH_KEYS_JSON_FILE=/run/secrets/audit_hash_keys_json
# AUDIT_ANCHOR_TOKEN_FILE=/run/secrets/audit_anchor_token
# AUDIT_ANCHOR_RECEIPT_KEYS_JSON_FILE=/run/secrets/audit_anchor_receipt_keys_json


# Abuse protection. Process-local; use distributed edge limits in production too.
MAX_REQUEST_BODY_BYTES=1048576
BILLING_RATE_LIMIT_PER_MINUTE=120
CREDENTIAL_RATE_LIMIT_PER_MINUTE=30
ROLLOUT_RATE_LIMIT_PER_MINUTE=30
VERIFICATION_WEBHOOK_RATE_LIMIT_PER_MINUTE=300
OPS_ALERT_RATE_LIMIT_REJECTION_THRESHOLD=20
OPS_ALERT_OVERSIZED_REQUEST_THRESHOLD=5


# External infrastructure integration.
# Production release gate requires these values.
METRICS_EXPORT_MODE=prometheus
EDGE_RATE_LIMIT_MODE=external
